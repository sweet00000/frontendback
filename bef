<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The FrontendBack v0.3 (Cloud Edition)</title>
    
    <script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/python/python.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/dracula.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
    <script src="https://sdk.amazonaws.com/js/aws-sdk-2.1001.0.min.js"></script>

    <style>
        :root { --bg: #1e1e1e; --panel: #252526; --accent: #007acc; --text: #cccccc; --border: #333; }
        body { margin: 0; background: var(--bg); color: var(--text); font-family: 'Segoe UI', sans-serif; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        
        /* Icons */
        .icon { width: 16px; display: inline-block; text-align: center; margin-right: 5px; }

        /* Layout */
        header { height: 40px; background: #2d2d2d; display: flex; align-items: center; padding: 0 1rem; justify-content: space-between; border-bottom: 1px solid #000; }
        #workspace { display: grid; grid-template-columns: 250px 1fr 320px; grid-template-rows: 65% 35%; height: calc(100vh - 40px); }
        
        /* Panels */
        .panel { border: 1px solid var(--border); background: var(--panel); display: flex; flex-direction: column; position: relative; }
        .panel-header { background: #333; padding: 5px 10px; font-size: 0.8rem; font-weight: bold; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }

        /* Left Sidebar: Files */
        #files-panel { grid-row: 1 / 3; grid-column: 1; border-right: 1px solid var(--border); }
        .file-tree { flex: 1; overflow-y: auto; padding: 5px; font-size: 0.9rem; }
        .file-node { padding: 4px; cursor: pointer; display: flex; align-items: center; }
        .file-node:hover { background: #37373d; }
        .cloud-section { margin-top: 10px; padding-top: 10px; border-top: 1px solid #444; }
        .cloud-btn { font-size: 0.8rem; background: #333; border: 1px solid #555; color: white; width: 100%; margin-bottom: 5px; cursor: pointer; padding: 4px; text-align: left; }
        .cloud-btn:hover { background: #444; }

        /* Center: Notebook */
        #notebook-panel { grid-row: 1; grid-column: 2; overflow-y: auto; padding: 20px; background: #1e1e1e; }
        .cell { margin-bottom: 15px; border: 1px solid #444; border-radius: 4px; background: #2d2d2d; }
        .cell-controls { background: #333; padding: 4px; display: flex; justify-content: flex-end; gap: 8px; border-bottom: 1px solid #444; }
        .cell-output { padding: 10px; font-family: monospace; white-space: pre-wrap; color: #fff; font-size: 0.9rem; border-top: 1px solid #444; }
        
        /* Bottom: Tabs (Terminal / Variables) */
        #bottom-panel { grid-row: 2; grid-column: 2; border-top: 1px solid var(--border); display: flex; flex-direction: column; background: #1e1e1e; }
        .tab-bar { display: flex; background: #252526; border-bottom: 1px solid #333; }
        .tab { padding: 5px 15px; cursor: pointer; font-size: 0.85rem; border-right: 1px solid #333; background: #2d2d2d; color: #888; }
        .tab.active { background: #1e1e1e; color: white; border-top: 2px solid var(--accent); }
        .tab-content { flex: 1; position: relative; overflow: hidden; display: none; }
        .tab-content.active { display: block; }

        /* Variable Viewer Table */
        #var-table { width: 100%; border-collapse: collapse; font-family: monospace; font-size: 13px; }
        #var-table th { text-align: left; background: #333; padding: 4px; position: sticky; top: 0; }
        #var-table td { border-bottom: 1px solid #333; padding: 4px; color: #ce9178; }
        #var-table tr:hover { background: #2a2d2e; }

        /* Right Sidebar: AI */
        #ai-panel { grid-row: 1 / 3; grid-column: 3; border-left: 1px solid var(--border); display: flex; flex-direction: column; }
        #chat-history { flex: 1; padding: 10px; overflow-y: auto; font-size: 0.9rem; }
        .msg { margin-bottom: 10px; padding: 8px; border-radius: 6px; max-width: 90%; line-height: 1.4; }
        .msg.user { background: #0e639c; color: white; align-self: flex-end; margin-left: auto; }
        .msg.ai { background: #3c3c3c; align-self: flex-start; border-left: 3px solid #ffaa00; }
        .input-area { padding: 10px; border-top: 1px solid #333; display: flex; gap: 5px; }
        input[type="text"], input[type="password"] { flex: 1; background: #3c3c3c; border: 1px solid #555; color: white; padding: 6px; border-radius: 3px; outline: none; }
        
        /* Modals / Inputs */
        .hidden-input { display: none; }
        button.primary { background: var(--accent); color: white; border: none; padding: 4px 12px; border-radius: 3px; cursor: pointer; }
        button.primary:hover { background: #005f9e; }

        /* Loader */
        #loader { position: fixed; inset: 0; background: rgba(0,0,0,0.95); z-index: 999; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .loader-bar { width: 200px; height: 4px; background: #333; margin-top: 10px; border-radius: 2px; overflow: hidden; }
        .loader-fill { width: 0%; height: 100%; background: var(--accent); transition: width 0.3s; }
    </style>
</head>
<body>

    <div id="loader">
        <h2>FrontendBack v0.3</h2>
        <div style="color:#888; font-size:0.9rem" id="load-msg">Booting Python Environment...</div>
        <div class="loader-bar"><div class="loader-fill" id="load-fill"></div></div>
    </div>

    <header>
        <div style="font-weight:bold; color: #fff;">THE FRONTENDBACK <span style="font-weight:normal; font-size:0.8rem; color:#888;">| Cloud Edition</span></div>
        <div style="font-size: 0.8rem; color:#aaa;">RAM Usage: <span id="mem-usage">--</span> MB</div>
    </header>

    <div id="workspace">
        
        <div id="files-panel" class="panel">
            <div class="panel-header">EXPLORER</div>
            <div class="file-tree" id="file-list">
                </div>
            
            <div class="cloud-section" style="padding:10px;">
                <div style="font-size:0.75rem; color:#888; margin-bottom:5px; font-weight:bold;">DATA SOURCES</div>
                
                <input type="file" id="local-upload" class="hidden-input" onchange="handleLocalUpload(this)">
                <button class="cloud-btn" onclick="document.getElementById('local-upload').click()">
                    📂 Mount Local File
                </button>

                <button class="cloud-btn" onclick="toggleCloudConfig('s3-config')">☁️ Connect S3 Bucket</button>
                <div id="s3-config" style="display:none; padding:5px; background:#222; border:1px solid #444; margin-bottom:5px;">
                    <input type="text" id="s3-bucket" placeholder="Bucket Name" style="width:90%; margin-bottom:3px; font-size:0.8rem;">
                    <input type="password" id="s3-key" placeholder="Access Key ID" style="width:90%; margin-bottom:3px; font-size:0.8rem;">
                    <button class="primary" style="width:100%; font-size:0.7rem;" onclick="mountS3()">Mount S3</button>
                </div>

                <button class="cloud-btn" onclick="alert('IPFS Gateway mounting: Connecting to ipfs.io...')">🌐 Connect IPFS</button>
            </div>
        </div>

        <div id="notebook-panel">
            <div style="text-align:center; margin-bottom:20px; border:1px dashed #444; padding:10px; color:#666;">
                <button class="primary" onclick="createCell()">+ New Code Cell</button>
            </div>
        </div>

        <div id="bottom-panel">
            <div class="tab-bar">
                <div class="tab active" onclick="switchTab('terminal')">Terminal (>_)</div>
                <div class="tab" onclick="switchTab('vars')">Variable Viewer ({x})</div>
            </div>
            
            <div id="tab-terminal" class="tab-content active" style="background: black; height:100%;">
                <div id="terminal-container" style="height:100%;"></div>
            </div>
            
            <div id="tab-vars" class="tab-content" style="overflow-y:auto; background: #1e1e1e;">
                <table id="var-table">
                    <thead>
                        <tr><th>Name</th><th>Type</th><th>Value / Preview</th></tr>
                    </thead>
                    <tbody id="var-body">
                        </tbody>
                </table>
            </div>
        </div>

        <div id="ai-panel" class="panel">
            <div class="panel-header">GEMINI ASSISTANT (2.0 Flash)</div>
            <div id="chat-history">
                <div class="msg ai">Hello! I am connected to the Gemini 2.0 Flash API. <br><br><b>Note:</b> Please verify your API Key in the code source before asking questions.</div>
            </div>
            <div class="input-area">
                <input type="text" id="ai-input" placeholder="Ask Gemini..." onkeypress="if(event.key==='Enter') sendGemini()">
                <button class="primary" onclick="sendGemini()">➤</button>
            </div>
        </div>
    </div>

    <script>
        // --- CONFIGURATION ---
        // ⚠️ PASTE YOUR KEY HERE ⚠️
        const GEMINI_API_KEY = "PASTE_YOUR_KEY_HERE"; 
        
        // --- GLOBALS ---
        let pyodide = null;
        let micropip = null;
        const cells = {};
        let term, fitAddon;

        // --- 1. INITIALIZATION ---
        async function boot() {
            const loaderFill = document.getElementById('load-fill');
            const loadMsg = document.getElementById('load-msg');

            try {
                // Load Pyodide
                loadMsg.innerText = "Downloading Pyodide...";
                pyodide = await loadPyodide();
                loaderFill.style.width = "50%";

                // Load Micropip
                loadMsg.innerText = "Loading Package Manager...";
                await pyodide.loadPackage("micropip");
                micropip = pyodide.pyimport("micropip");
                loaderFill.style.width = "80%";

                // Setup default env
                await pyodide.runPythonAsync(`
                    import sys
                    import os
                    os.makedirs('/mnt/s3', exist_ok=True)
                    os.makedirs('/mnt/local', exist_ok=True)
                `);

                loaderFill.style.width = "100%";
                setTimeout(() => document.getElementById('loader').style.display = 'none', 500);

                // Initialize Terminal
                initTerminal();
                
                // Refresh File List
                refreshFileList();

                // Create starter cell
                createCell("# Welcome to FrontendBack v0.3\nimport sys\nprint(sys.version)\n\n# Define a variable to test the viewer:\nmy_data = {'id': 1, 'name': 'FrontendBack'}\nvalues = [10, 20, 30, 40]");

            } catch (err) {
                loadMsg.innerText = "Error: " + err;
                loadMsg.style.color = "red";
            }
        }
        boot();

        // --- 2. TERMINAL LOGIC ---
        function initTerminal() {
            term = new Terminal({ theme: { background: '#000000' }, fontSize: 13, cursorBlink: true });
            fitAddon = new FitAddon.FitAddon();
            term.loadAddon(fitAddon);
            term.open(document.getElementById('terminal-container'));
            fitAddon.fit();
            
            term.write('\x1b[32mFrontendBack Shell initialized.\x1b[0m\r\n');
            term.write('Type python commands or "pip install ..."\r\n$ ');

            let cmd = '';
            term.onData(e => {
                if(e === '\r') {
                    term.write('\r\n');
                    handleTermCommand(cmd);
                    cmd = '';
                } else if (e === '\x7F') {
                    if (cmd.length > 0) {
                        term.write('\b \b');
                        cmd = cmd.slice(0, -1);
                    }
                } else {
                    cmd += e;
                    term.write(e);
                }
            });
            
            window.addEventListener('resize', () => fitAddon.fit());
        }

        async function handleTermCommand(cmd) {
            cmd = cmd.trim();
            if(!cmd) { term.write('$ '); return; }

            if(cmd.startsWith("pip install ")) {
                const pkg = cmd.replace("pip install ", "");
                term.write(`\x1b[33mInstalling ${pkg}...\x1b[0m\r\n`);
                try {
                    await micropip.install(pkg);
                    term.write(`Success.\r\n$ `);
                } catch(e) { term.write(`Error: ${e}\r\n$ `); }
            } else {
                try {
                    // Redirect stdout specifically for terminal commands
                    pyodide.setStdout({ batched: (t) => term.write(t + '\r\n') });
                    await pyodide.runPythonAsync(cmd);
                    term.write('$ ');
                } catch(e) {
                    term.write(`\x1b[31m${e}\x1b[0m\r\n$ `);
                }
            }
            // Always refresh vars after a shell command
            updateVariableViewer();
        }

        // --- 3. NOTEBOOK LOGIC ---
        function createCell(content = "") {
            const container = document.getElementById('notebook-panel');
            const id = 'cell-' + Date.now();
            
            const div = document.createElement('div');
            div.className = 'cell';
            div.innerHTML = `
                <div class="cell-controls">
                    <button class="primary" style="font-size:0.7rem; background:#444;" onclick="this.parentElement.parentElement.remove()">Del</button>
                    <button class="primary" onclick="runCell('${id}')">▶ Run</button>
                </div>
                <textarea id="${id}-area">${content}</textarea>
                <div id="${id}-out" class="cell-output"></div>
            `;
            
            // Insert before the add button div
            container.insertBefore(div, container.lastElementChild);
            
            const cm = CodeMirror.fromTextArea(document.getElementById(`${id}-area`), {
                mode: "python", theme: "dracula", lineNumbers: true, viewportMargin: Infinity
            });
            cells[id] = { cm, out: `${id}-out` };
        }

        async function runCell(id) {
            const cell = cells[id];
            const code = cell.cm.getValue();
            const outDiv = document.getElementById(cell.out);
            
            outDiv.innerText = "Running...";
            const logs = [];
            
            // Capture output
            pyodide.setStdout({ batched: (t) => logs.push(t) });
            pyodide.setStderr({ batched: (t) => logs.push(`[err] ${t}`) });

            try {
                let res = await pyodide.runPythonAsync(code);
                let text = logs.join('\n');
                if(res !== undefined) text += `\n[Out]: ${res}`;
                outDiv.innerText = text || "(No output)";
                outDiv.style.color = "#ccc";
            } catch (e) {
                outDiv.innerText = e;
                outDiv.style.color = "#ff5555";
            }
            
            updateVariableViewer();
            refreshFileList(); // In case they wrote a file
        }

        // --- 4. VARIABLE VIEWER ---
        function switchTab(tab) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            
            if(tab === 'terminal') {
                document.querySelector('.tab:nth-child(1)').classList.add('active');
                document.getElementById('tab-terminal').classList.add('active');
                fitAddon.fit();
            } else {
                document.querySelector('.tab:nth-child(2)').classList.add('active');
                document.getElementById('tab-vars').classList.add('active');
                updateVariableViewer();
            }
        }

        function updateVariableViewer() {
            if(!pyodide) return;
            const tbody = document.getElementById('var-body');
            tbody.innerHTML = "";
            
            // Python script to inspect globals and return JSON
            // We skip builtins and imports to keep it clean
            const inspector = `
import json
import types

safe_vars = []
ignore = ['In', 'Out', 'exit', 'quit', 'open', 'get_ipython']

for name, val in globals().items():
    if name.startswith('_') or name in ignore: continue
    if isinstance(val, (types.ModuleType, types.FunctionType, type)): continue
    
    try:
        t = type(val).__name__
        v = str(val)
        if len(v) > 50: v = v[:50] + "..."
        safe_vars.append({"name": name, "type": t, "val": v})
    except:
        pass

json.dumps(safe_vars)
            `;
            
            try {
                const jsonStr = pyodide.runPython(inspector);
                const data = JSON.parse(jsonStr);
                
                data.forEach(item => {
                    const row = `<tr><td><b>${item.name}</b></td><td><span style="color:#4ec9b0">${item.type}</span></td><td>${item.val}</td></tr>`;
                    tbody.innerHTML += row;
                });
            } catch(e) {
                console.error("Var inspector error", e);
            }
        }

        // --- 5. CLOUD & FILES ---
        function refreshFileList() {
            // Simple listing of current directory
            if(!pyodide) return;
            const files = pyodide.FS.readdir('.');
            const list = document.getElementById('file-list');
            list.innerHTML = "";
            
            files.forEach(f => {
                if(f === "." || f === "..") return;
                list.innerHTML += `<div class="file-node"><span class="icon">📄</span> ${f}</div>`;
            });
            
            // Check Mounts
            if(pyodide.FS.analyzePath('/mnt/local').exists) {
                 list.innerHTML += `<div class="file-node" style="color:#4ec9b0"><span class="icon">📂</span> /mnt/local (Active)</div>`;
            }
        }

        async function handleLocalUpload(input) {
            const file = input.files[0];
            if(!file) return;
            
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                pyodide.FS.writeFile(file.name, data);
                term.write(`\r\n[System] Uploaded ${file.name}\r\n$ `);
                refreshFileList();
            };
            reader.readAsArrayBuffer(file);
        }

        function toggleCloudConfig(id) {
            const el = document.getElementById(id);
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }

        function mountS3() {
            const bucket = document.getElementById('s3-bucket').value;
            // In a real app, we would use AWS SDK here to list objects
            // and then create a "lazy loading" FUSE-like system via pyodide.
            // For this MVP, we just confirm config storage.
            alert(`S3 Config Stored for bucket: ${bucket}.\n\n(Note: To read S3 in WASM, you usually presign URLs in JS and pass them to Python, or use 'boto3-lite' if available via micropip.)`);
        }

        // --- 6. GEMINI API CHAT ---
        async function sendGemini() {
            const input = document.getElementById('ai-input');
            const chat = document.getElementById('chat-history');
            const prompt = input.value.trim();
            if(!prompt) return;

            // 1. User UI
            chat.innerHTML += `<div class="msg user">${prompt}</div>`;
            input.value = "Thinking...";
            input.disabled = true;
            chat.scrollTop = chat.scrollHeight;

            try {
                if(GEMINI_API_KEY.includes("PASTE")) {
                    throw new Error("Please update GEMINI_API_KEY in source code.");
                }

                const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${GEMINI_API_KEY}`;
                
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }]
                    })
                });

                const data = await response.json();
                
                if(data.error) throw new Error(data.error.message);

                const reply = data.candidates[0].content.parts[0].text;
                
                // 2. AI UI
                chat.innerHTML += `<div class="msg ai">${markedParse(reply)}</div>`;

            } catch(e) {
                chat.innerHTML += `<div class="msg ai" style="color:red">Error: ${e.message}</div>`;
            }

            input.value = "";
            input.disabled = false;
            input.focus();
            chat.scrollTop = chat.scrollHeight;
        }

        // Very simple markdown parser for bolding/code in chat
        function markedParse(text) {
            // Bold
            text = text.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
            // Code blocks
            text = text.replace(/```([\s\S]*?)```/g, '<pre style="background:#222; padding:5px; border-radius:4px;">$1</pre>');
            return text;
        }

    </script>
</body>
</html>
